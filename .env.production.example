# Copy to .env.production. Do not commit the populated file.
POSTGRES_DB=kebaikanku
POSTGRES_USER=kebaikanku
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Use the internal Compose hostname `postgres`; URL-encode special characters.
DB_DSN=host=postgres user=kebaikanku password=replace-with-a-long-random-password dbname=kebaikanku port=5432 sslmode=disable TimeZone=Asia/Jakarta
MIGRATION_DATABASE_URL=postgres://kebaikanku:replace-with-a-long-random-password@postgres:5432/kebaikanku?sslmode=disable&x-migrations-table=kebaikanku_migrations
API_PORT=8080
CORS_ALLOWED_ORIGINS=https://kebaikanku.id,https://app.kebaikanku.id
PUBLIC_RATE_LIMIT_PER_MINUTE=120

# Bootstrap one controlled-pilot organization before the dashboard creates campaigns.
PILOT_ORGANIZATION_ID=pilot-org
PILOT_ORGANIZATION_NAME=Contoh Yayasan
PILOT_ORGANIZATION_EMAIL=admin@example.org

# Single-admin dashboard credentials. Keep both values in the host secret store.
ADMIN_PASSWORD=replace-with-a-long-admin-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_SETTINGS_ENCRYPTION_KEY=replace-with-base64-encoded-32-random-bytes
UPLOAD_DIR=/data/uploads
PUBLIC_UPLOAD_BASE_URL=https://api.kebaikanku.id/uploads
MIDTRANS_ENV=production
MIDTRANS_SERVER_KEY=replace-with-midtrans-production-server-key
MIDTRANS_CLIENT_KEY=replace-with-midtrans-production-client-key
MIDTRANS_NOTIFICATION_TOKEN=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=kebaikanku.id
SMTP_ENCRYPTION=
WAITLIST_ADMIN_EMAIL=
WAITLIST_EMAIL_URL=https://kebaikanku.id
