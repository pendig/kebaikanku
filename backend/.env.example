PORT=8080
APP_ENV=development

# Database
DB_DRIVER=sqlite
DB_DSN=kebaikanku.db

# PostgreSQL local example:
# DB_DRIVER=postgres
# DB_DSN=host=localhost user=kebaikanku password=kebaikanku dbname=kebaikanku port=5432 sslmode=disable TimeZone=Asia/Jakarta

# Auth, required once login/register endpoints are implemented.
JWT_SECRET=change-me-in-local-development

# Midtrans, initial payment gateway.
MIDTRANS_ENV=sandbox
MIDTRANS_SERVER_KEY=SB-Mid-server-your-server-key
MIDTRANS_CLIENT_KEY=SB-Mid-client-your-client-key
MIDTRANS_NOTIFICATION_TOKEN=

# SMTP / Email Delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=email
SMTP_PASS=password
SMTP_FROM=email
SMTP_FROM_NAME=kebaikanku.id
SMTP_ENCRYPTION=tls
WAITLIST_EMAIL_URL=https://kebaikanku.id/coming-soon
WAITLIST_ADMIN_EMAIL=admin@example.com
