# SEO Environment Variables for SvelteKit Landing Page
PUBLIC_SEO_SITE_NAME="kebaikanku.id"
PUBLIC_SEO_TITLE="kebaikanku.id - Transparent Donation Platform"
PUBLIC_SEO_DESCRIPTION="Open-source crowdfunding and donation platform for zakat and kemanusiaan institutions. 0% platform fee for self-hosted."
PUBLIC_SEO_SITE_URL="https://kebaikanku.id"
PUBLIC_SEO_IMAGE="/images/og-image.png"
PUBLIC_SEO_KEYWORDS="donasi, zakat, open-source, crowdfunding, infak, sedekah, kemanusiaan, yayasan, filantropi"

# Analytics Configuration (Optional, set to enable GA4 or GTM)
PUBLIC_GA_TRACKING_ID=""
PUBLIC_GTM_CONTAINER_ID=""

# Waitlist endpoint for coming-soon form
PUBLIC_WAITLIST_API_URL="http://localhost:8080/api/v1/waitlist"
